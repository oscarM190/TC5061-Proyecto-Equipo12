# Copiar a .env para cambiar la configuración de docker compose (todas son opcionales).
MLFLOW_PORT=5000
API_PORT=8000
# Registro de MLflow: volumen con nombre (por defecto) o una carpeta local con mlflow.db y
# mlartifacts/ de un servidor existente, por ejemplo MLFLOW_STORE=./serving/mlflow-store
MLFLOW_STORE=mlflow-store
MIBICI_MODEL_ALIAS=champion
# Procesos de Uvicorn y límites de recursos de la API
API_WORKERS=1
API_CPUS=2
API_MEMORY=1g
WORKER_REPLICAS=1
