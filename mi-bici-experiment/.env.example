# Copia este archivo como .env (ignorado por Git) y llena los valores locales.
# config.py lo carga con python-dotenv; nunca escribas credenciales en el código ni en MLflow.

# Servidor de tracking de MLflow (ver README, "Servidor de tracking")
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si el servidor de tracking tiene autenticación
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Etiqueta `entorno` de cada corrida (local, vps, ci)
MIBICI_ENTORNO=local
